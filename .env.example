# ClientAtlas environment template.
#
# Copy to .env and fill in. Never commit .env — it is git-ignored, and that
# is the only thing standing between a local key and a public repository.
#
# There are deliberately no defaults for anything that points at a database or
# a paid API. A default would let a mistyped value silently reach the wrong
# system instead of failing on startup.

# ─── Application mode ────────────────────────────────────────────────────────
# local — real documents, local models, nothing leaves the machine.
# demo  — synthetic seeded data, read-only, all mutations rejected.
CLIENTATLAS_MODE=local

# ─── Local PostgreSQL (docker compose) ───────────────────────────────────────
POSTGRES_USER=clientatlas
POSTGRES_PASSWORD=clientatlas
POSTGRES_DB=clientatlas
POSTGRES_PORT=5433

# One credential per responsibility. The roles themselves are created by the
# M2 migrations; until then only MIGRATION_DATABASE_URL is meaningful and it
# points at the bootstrap superuser.
#
#   migration_role — owns the schema, runs migrations, never serves requests
#   runtime_role   — NOBYPASSRLS, non-owner, cannot migrate, serves user requests
#   worker_role    — ingestion and storage only
#   test_role      — disposable integration databases only
MIGRATION_DATABASE_URL=postgresql://clientatlas:clientatlas@localhost:5433/clientatlas
RUNTIME_DATABASE_URL=
WORKER_DATABASE_URL=
TEST_DATABASE_URL=

# ─── Supabase (M2) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security entirely. It belongs to the worker and to
# migrations. If you find yourself importing this from anything that serves a
# user request, the request path has a hole in it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI model service ────────────────────────────────────────────────────────
CLIENTATLAS_AI_MODE=local

# Ollama runs natively on the host. On Apple Silicon a containerised Ollama
# gets no GPU access and is much slower, so the compose profile is opt-in.
CLIENTATLAS_AI_OLLAMA_BASE_URL=http://localhost:11434
CLIENTATLAS_AI_GENERATION_MODEL=qwen3:8b

# Must stay false for any workspace holding real documents. There is no
# fallback path from confidential mode to a hosted provider, by design.
CLIENTATLAS_AI_ALLOW_HOSTED_PROVIDERS=false

# ─── Optional hosted provider — synthetic demo workspaces only ───────────────
# Used only when the workspace is explicitly marked synthetic AND hosted
# providers are allowed. Leave blank to fall back to deterministic demo output.
GROQ_API_KEY=
