# ClientAtlas environment template.
#
# Copy to .env and fill in. Never commit .env — it is git-ignored, and that
# is the only thing standing between a local key and a public repository.
#
# There are deliberately no defaults for anything that points at a database or
# a paid API. A default would let a mistyped value silently reach the wrong
# system instead of failing on startup.

# ─── Application mode ────────────────────────────────────────────────────────
# local — real documents, local models, nothing leaves the machine.
# demo  — synthetic seeded data, read-only, all mutations rejected.
CLIENTATLAS_MODE=local

# ─── Local database ──────────────────────────────────────────────────────────
#
# Development runs against the Supabase local stack (`supabase start`), which
# provides PostgreSQL 17 with pgvector, GoTrue for auth, and the Storage API on
# one set of ports. Its PostgreSQL listens on 54322.
#
# `docker-compose.yml` still ships a plain pgvector container on 5433 as a
# lighter local option when you are not touching auth or storage. CI runs the
# full Supabase stack, because the storage-policy tests assert against the real
# Storage service and a substitute would only be testing the substitute.
# Point the URLs below at whichever you are running.
POSTGRES_USER=clientatlas
POSTGRES_PASSWORD=clientatlas
POSTGRES_DB=clientatlas
POSTGRES_PORT=5433

# One credential per responsibility. The roles are created by
# infrastructure/docker/postgres/init/01-roles.sql when the data volume is first
# created; the passwords below match it and are local-development only.
#
#   migration — owns the schema, runs migrations, never serves a request.
#               Deliberately not a superuser: FORCE ROW LEVEL SECURITY does not
#               apply to superusers, so a superuser owner would silently see
#               every tenant's rows.
#   runtime   — what the web application connects as. NOINHERIT and NOBYPASSRLS,
#               so it holds no table privileges until it explicitly assumes the
#               `authenticated` role inside the claims helper.
#   worker    — ingestion and storage only.
#   test      — integration-test fixtures only. Holds BYPASSRLS so the harness
#               can seed the `profiles` rows Supabase would create at signup.
#               The application must never use this.
#
# Supabase local stack (default). Swap 54322/postgres for 5433/clientatlas to
# use the plain compose container instead.
MIGRATION_DATABASE_URL=postgresql://clientatlas_migration:local_migration_only@127.0.0.1:54322/postgres
RUNTIME_DATABASE_URL=postgresql://clientatlas_runtime:local_runtime_only@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=postgresql://clientatlas_worker:local_worker_only@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://clientatlas_test:local_test_only@127.0.0.1:54322/postgres

# ─── Supabase ────────────────────────────────────────────────────────────────
#
# The values below are the Supabase local-stack defaults. They are identical on
# every developer's machine, are published in Supabase's own documentation, and
# authenticate to nothing but 127.0.0.1 — so they are committed deliberately, to
# keep `supabase start && pnpm dev` a two-command setup.
#
# A hosted project's keys are real secrets. They belong in .env only, which is
# git-ignored, and never in this file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Bypasses row-level security entirely. It belongs to the worker, to migrations
# and to test fixtures. If you find yourself importing this from anything that
# serves a user request, the request path has a hole in it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Key material for verifying access tokens. Configure exactly ONE of these:
# the project's symmetric JWT secret, or the URL of its published JWKS.
# Accepting both would mean a token signed either way is valid.
#
# This is the local stack's well-known secret, so tokens issued by the local
# GoTrue verify against it. A hosted project's secret replaces it in .env.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ─── AI model service ────────────────────────────────────────────────────────
CLIENTATLAS_AI_MODE=local

# Ollama runs natively on the host. On Apple Silicon a containerised Ollama
# gets no GPU access and is much slower, so the compose profile is opt-in.
CLIENTATLAS_AI_OLLAMA_BASE_URL=http://localhost:11434
CLIENTATLAS_AI_GENERATION_MODEL=qwen3:8b

# Must stay false for any workspace holding real documents. There is no
# fallback path from confidential mode to a hosted provider, by design.
CLIENTATLAS_AI_ALLOW_HOSTED_PROVIDERS=false

# ─── Optional hosted provider — synthetic demo workspaces only ───────────────
# Used only when the workspace is explicitly marked synthetic AND hosted
# providers are allowed. Leave blank to fall back to deterministic demo output.
GROQ_API_KEY=
